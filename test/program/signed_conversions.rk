pack ConversionSamples {
  i32: words;
  f32: values;
  u32: unsigned_words;
}

run rounded_floats(input: stack ConversionSamples, <count: i32>) -> i32:
  for row in input using i32s up to <count>:
    yield to_i32(row.values)

run rounded_words(input: stack ConversionSamples, <count: i32>) -> f32:
  for row in input using f32s up to <count>:
    yield to_f32(row.words)

run rounded_unsigned_words(input: stack ConversionSamples, <count: i32>) -> f32:
  for row in input using f32s up to <count>:
    yield to_f32(row.unsigned_words)

run rounded_unsigned_floats(input: stack ConversionSamples, <count: i32>) -> u32:
  for row in input using u32s up to <count>:
    yield to_u32(row.values)

slow main() -> i32:
  words: [7]i32 := [0, 1, -1, 16777217, 16777219, 2147483647, -2147483648]
  values: [7]f32 := [2.5, -2.5, 0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0, 2147483648.0, -2147483648.0]
  integers: [7]i32 := [0; 7]
  floats: [7]f32 := [0.0; 7]
  unsigned_words: [7]u32 := [0, 1, 65535, 65536, 16777217, 2147483649, 4294967295]
  rounded_floats(stack ConversionSamples { words: words, values: values, unsigned_words: unsigned_words }, <7>, integers)
  rounded_words(stack ConversionSamples { words: words, values: values, unsigned_words: unsigned_words }, <7>, floats)
  if integers[0] != 2 or integers[1] != -2 or integers[2] != 0:
    return 1
  if integers[3] != 2147483647 or integers[4] != -2147483648:
    return 2
  if integers[5] != 2147483647 or integers[6] != -2147483648:
    return 3
  if floats[3] != 16777216.0 or floats[4] != 16777220.0:
    return 4
  if floats[5] != 2147483648.0 or floats[6] != -2147483648.0:
    return 5
  rounded_unsigned_words(stack ConversionSamples { words: words, values: values, unsigned_words: unsigned_words }, <7>, floats)
  if floats[0] != 0.0 or floats[1] != 1.0 or floats[2] != 65535.0 or floats[3] != 65536.0:
    return 6
  if floats[4] != 16777216.0 or floats[5] != 2147483648.0 or floats[6] != 4294967296.0:
    return 7
  rounded_unsigned_floats(stack ConversionSamples { words: words, values: values, unsigned_words: unsigned_words }, <7>, unsigned_words)
  if unsigned_words[0] != 2 or unsigned_words[1] != 0 or unsigned_words[2] != 0:
    return 8
  if unsigned_words[3] != 4294967295 or unsigned_words[4] != 0:
    return 9
  if unsigned_words[5] != 2147483648 or unsigned_words[6] != 0:
    return 10
  return 171
