~~ A run storing columns of a pack it doesn't traverse: the call traps
~~ because the output column holds fewer elements than the count.
pack In {
  f32: x;
}

pack Out {
  f32: y;
}

run copy(input: stack In, out: mut stack Out, <n: i64>):
  for chunk in input using f32s up to <n>:
    out.y <- chunk.x

slow main() -> i32:
  x: [8]f32 := [0.0; 8]
  y: [5]f32 := [0.0; 5]
  copy(stack In { x: x }, stack Out { y: y }, <8>)
  return 0
