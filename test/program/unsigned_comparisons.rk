~~ Hand-specified unsigned ordering across bit 31, including uniform
~~ broadcasts and masked selection. Every error has a distinct result.
scratch below(values: u32s, <cut: u32>) -> u32:
  bitmask(values < <cut>)

run unsigned_rows(a: []u32, b: []u32, out: mut []u32, masks: mut []u32, <cut: u32>):
  let left = a[<0>]
  let right = b[<0>]
  out[<0>] <- if left < right then left else right
  let <less: u32> = bitmask(left < right)
  let <greater: u32> = bitmask(left > right)
  let <equal: u32> = bitmask(left = right)
  let <threshold: u32> = below(left, <cut>)
  masks[<0>] <- <less>
  masks[<4>] <- <greater>
  masks[<8>] <- <equal>
  masks[<12>] <- <threshold>

slow main() -> i32:
  a: [4]u32 := [0, 2147483647, 2147483648, 4294967295]
  b: [4]u32 := [4294967295, 2147483648, 2147483647, 4294967295]
  out: [4]u32 := [0; 4]
  masks: [16]u32 := [0; 16]
  unsigned_rows(a, b, out, masks, <2147483648>)
  if out[0] != 0 or out[1] != 2147483647 or out[2] != 2147483647 or out[3] != 4294967295:
    return 1
  for i from 0 up to 4:
    if masks[i] != 3 or masks[i + 4] != 4 or masks[i + 8] != 8 or masks[i + 12] != 3:
      return 2
  return 0
