scratch strict_reduce_add(values: f32s) -> f32:
  sum(values)

scratch strict_reduce_mul(values: f32s) -> f32:
  product(values)

scratch strict_reduce_min(values: f32s) -> f32:
  minimum(values)

scratch strict_reduce_max(values: f32s) -> f32:
  maximum(values)

scratch strict_scan_add(values: f32s) -> f32s:
  scan_sum(values)

scratch strict_scan_mul(values: f32s) -> f32s:
  scan_product(values)

scratch strict_scan_min(values: f32s) -> f32s:
  scan_minimum(values)

scratch strict_scan_max(values: f32s) -> f32s:
  scan_maximum(values)

scratch scan_keep_source(values: f32s) -> f32s:
  scan_sum(values) + values
