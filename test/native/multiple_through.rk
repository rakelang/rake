rake guarded_roots(values: f32s) -> f32s:
  tine #nonnegative means values >= <0.0>
  tine #negative means values < <0.0>
  through #nonnegative else <0.0> into positive:
    sqrt(values)
  through #negative else <0.0> into negative:
    -sqrt(-values)
  sweep:
    | #nonnegative => positive
    | #negative => negative
    | _ => <0.0>

crunch ordered_difference(a: f32s, b: f32s) -> f32s:
  select(a != b, <1.0>, <0.0>)
