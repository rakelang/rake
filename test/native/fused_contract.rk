crunch fused_contract(a: f32s, b: f32s) -> f32s:
  | sum: f32s <| a + b
  | result: f32s <| sqrt(sum * sum)
  return result

~~ A stage may introduce a constant or choose by a mask, and a through
~~ block's fused bindings form a region of their own.
crunch fused_stages(a: f32s, b: f32s) -> f32s:
  | scaled <| a * b
  | shifted <| scaled + <1.5>
  | chosen <| if a < b then shifted else b
  return chosen

rake fused_through(a: f32s, b: f32s) -> f32s:
  tine #positive when a > <0.0>
  through #positive else <0.0> into rooted:
    | product: f32s <| a * b
    | root <| sqrt(product) + a
    root
  sweep:
    | #positive => rooted
    | _ => a
