~~ Runs exercised through their wasm32 C boundary by harness.c.

pack Samples {
  f32: value;
  u8: quality;
}

pack Scaled {
  f32: result;
}

pack Pair {
  f32: a, b;
}

pack Quotients {
  f32: quotient;
}

pack Both {
  f32: sum, difference;
}

pack Bytes {
  u8: v;
}

pack Particle {
  f32: x, v;
  u8: alive;
}

run scale_values(input: stack Samples, output: stack Scaled, <scale: f32>) -> stack Scaled:
  let quality = to_f32(bitcast(i32s, widen(input.quality)))
  output with { result: input.value * <scale> + quality }

run divide(input: stack Pair, output: stack Quotients) -> stack Quotients:
  output with { quotient: input.a / input.b }

run both(input: stack Pair, out: stack Both) -> stack Both:
  out with { sum: input.a + input.b, difference: input.a - input.b }

run offset(x: []f32, out: mut []f32, shift: f32s, <n: i32>):
  for <i: i32> from <0> up to <n> by <4>:
    out[<i>] <- x[<i>] + shift

run floor_bytes(input: stack Bytes) -> stack Bytes:
  input with { v: max(input.v, 10) }

run advance(particles: stack Particle, <dt: f32>) -> stack Particle:
  let alive = widen(particles.alive)
  tine #moving means alive != <0>
  particles with { x: particles.x + particles.v * <dt> } where #moving

run survivors(particles: stack Particle) -> stack Particle:
  let alive = widen(particles.alive)
  tine #kept means alive != <0>
  compact particles where #kept
