scratch signed_to_float(values: i32s) -> f32s:
  to_f32(values)

scratch unsigned_to_float(values: u32s) -> f32s:
  to_f32(values)

scratch conversion_keep_unsigned(values: u32s) -> f32s:
  | first <| to_f32(values)
  | second <| to_f32(values + <1>)
  first + second

scratch float_to_signed(values: f32s) -> i32s:
  to_i32(values)

scratch float_to_unsigned(values: f32s) -> u32s:
  to_u32(values)

scratch conversion_unsigned_roundtrip(values: u32s) -> u32s:
  | rounded <| to_u32(to_f32(values))
  rounded + values

scratch conversion_keep_integer(values: i32s) -> i32s:
  | rounded <| to_i32(to_f32(values))
  rounded + values

scratch conversion_keep_float(values: f32s) -> i32s:
  | first <| to_i32(values)
  | second <| to_i32(values + <0.25>)
  first + second

scratch conversion_keep_unsigned_float(values: f32s) -> u32s:
  | first <| to_u32(values)
  | second <| to_u32(values + <0.25>)
  first + second

rake masked_signed_to_float(selector: f32s, values: i32s) -> f32s:
  tine #enabled means selector > <0.0>
  through #enabled into converted:
    to_f32(values)
  sweep:
    | #enabled => converted
    | #enabled gaps => <-2.0>

rake masked_unsigned_to_float(selector: f32s, values: u32s) -> f32s:
  tine #enabled means selector > <0.0>
  through #enabled into converted:
    to_f32(values)
  sweep:
    | #enabled => converted
    | #enabled gaps => <-2.0>

rake masked_float_to_signed(selector: f32s, values: f32s) -> i32s:
  tine #enabled means selector > <0.0>
  through #enabled into converted:
    to_i32(values)
  sweep:
    | #enabled => converted
    | #enabled gaps => <-2>

rake masked_float_to_unsigned(selector: f32s, values: f32s) -> u32s:
  tine #enabled means selector > <0.0>
  through #enabled into converted:
    to_u32(values)
  sweep:
    | #enabled => converted
    | #enabled gaps => bitcast(u32s, <-2>)

pack ConversionInput {
  f32: values;
  i32: words;
  i16: small;
  u32: unsigned_words;
}

pack CompactUnsignedInput {
  u16: words;
}

pack ConversionOutput {
  i32: words;
  f32: values;
  u32: unsigned_words;
}

run convert_to_signed(input: stack ConversionInput, output: stack ConversionOutput) -> stack ConversionOutput:
  output with { words: to_i32(input.values) }

run convert_to_unsigned(input: stack ConversionInput, output: stack ConversionOutput) -> stack ConversionOutput:
  output with { unsigned_words: to_u32(input.values) }

run unsigned_conversion_update(output: stack ConversionOutput) -> stack ConversionOutput:
  output with { unsigned_words: to_u32(to_f32(output.unsigned_words)) }

run convert_to_float(input: stack ConversionInput, output: stack ConversionOutput) -> stack ConversionOutput:
  output with { values: to_f32(input.words) }

run convert_compact(input: stack ConversionInput, output: stack ConversionOutput) -> stack ConversionOutput:
  output with { values: to_f32(widen(input.small)) }

run conversion_update(output: stack ConversionOutput) -> stack ConversionOutput:
  output with { values: to_f32(to_i32(output.values)) }

run convert_unsigned(input: stack ConversionInput, output: stack ConversionOutput) -> stack ConversionOutput:
  output with { values: to_f32(input.unsigned_words) }

run convert_unsigned_compact(input: stack CompactUnsignedInput, output: stack ConversionOutput) -> stack ConversionOutput:
  output with { values: to_f32(widen(input.words)) }
