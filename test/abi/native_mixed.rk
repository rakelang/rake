~~ The C compiler lowers orchestration; these kernels remain Rake-owned assembly.
scratch native_identity(<value: f32>) -> f32:
  <value>

scratch native_scale(values: f32s, <factor: f32>, offsets: f32s) -> f32s:
  | scaled <| values * <factor>
  | shifted <| scaled + offsets
  shifted

scratch native_all_positive(<value: f32>) -> bool:
  all(<value> > <0.0>)

scratch native_any_positive(<value: f32>) -> bool:
  any(<value> > <0.0>)

scratch native_positive_bits(<value: f32>) -> u32:
  bitmask(<value> > <0.0>)

scratch native_uniform_choice(<left: f32>, <right: f32>, <value: f32>) -> f32:
  let values = <value> * <1.0>
  let selected = if <left> > <right> then values else <-0.0>
  extract(selected, 0)

scratch native_signed_identity(<value: i32>) -> i32:
  <value>

scratch native_signed_uniform_choice(<left: i32>, <right: i32>, <value: f32>) -> f32:
  let selected: f32s = if <left> <= <right> then <value> else <-0.0>
  extract(selected, 0)

scratch native_boolean_choice(<take: bool>, <value: f32>) -> f32:
  let selected: f32s = if <take> then <value> else <-0.0>
  extract(selected, 0)

scratch native_boolean_literal() -> f32:
  let selected: f32s = if < true > then <2.5> else <-0.0>
  let <value: f32> = extract(selected, 0)
  native_boolean_choice(<true>, <value>)

scratch native_boolean_literal_binding() -> f32:
  let <enabled: bool> = < false >
  let selected: f32s = if <enabled> then <2.5> else <-0.0>
  extract(selected, 0)

scratch native_reduced_choice(<value: f32>) -> f32:
  let <take: bool> = all(<value> > <0.0>)
  native_boolean_choice(<take>, <value>)

scratch native_unsigned_uniform_choice(<left: u32>, <right: u32>) -> bool:
  let selected = if <left> >= <right> then <1.0> else <0.0>
  all(selected > <0.0>)

scratch native_unsigned_identity(<value: u32>) -> u32:
  <value>

scratch native_unsigned_literal() -> u32:
  native_unsigned_identity(<4294967295>)

scratch native_signed_literal() -> i32:
  native_signed_identity(<-2147483648>)

scratch native_signed_bits(<value: i32>, <factor: f32>, <limit: i32>) -> u32:
  let values: i32s = <value>
  let flags = values < <limit>
  bitmask(flags)

scratch native_unsigned_bits(<factor: f32>, <value: u32>, <limit: u32>) -> u32:
  let values: u32s = <value>
  bitmask(values >= <limit>)

scratch native_extract_signed(<value: i32>) -> i32:
  let values: i32s = <value>
  extract(values, 3)

scratch native_insert_unsigned(<value: u32>, <replacement: u32>) -> u32:
  let values: u32s = <value>
  let changed = insert(values, 3, <replacement>)
  extract(changed, 3)

scratch native_relocate_unsigned(<value: u32>) -> u32:
  let values: u32s = <value>
  let <picked: u32> = extract(values, 0)
  extract(insert(values, 3, <picked>), 3)

slow main() -> i32:
  let original: f32 = -0.0
  let carried = native_identity(<original>)
  if bitcast(u32, carried) != bitcast(u32, original):
    return 1
  if not native_all_positive(<1.0>) or native_all_positive(<-1.0>):
    return 2
  if not native_any_positive(<1.0>) or native_any_positive(<-1.0>):
    return 2
  if native_positive_bits(<-1.0>) != 0 or bit_and(native_positive_bits(<1.0>), 15) != 15:
    return 2
  if native_uniform_choice(<2.0>, <1.0>, <3.5>) != 3.5:
    return 4
  if bitcast(u32, native_uniform_choice(<1.0>, <2.0>, <3.5>)) != bitcast(u32, original):
    return 4
  if native_signed_identity(<-2147483648>) != -2147483648 or native_unsigned_identity(<4294967295>) != 4294967295:
    return 5
  if native_unsigned_literal() != 4294967295 or native_signed_literal() != -2147483648:
    return 5
  if bit_and(native_signed_bits(<-2147483648>, <2.0>, <0>), 15) != 15 or native_signed_bits(<2147483647>, <2.0>, <0>) != 0:
    return 6
  if bit_and(native_unsigned_bits(<2.0>, <4294967295>, <2147483648>), 15) != 15 or native_unsigned_bits(<2.0>, <2147483647>, <2147483648>) != 0:
    return 7
  if native_signed_uniform_choice(<-2147483648>, <2147483647>, <3.5>) != 3.5:
    return 8
  if bitcast(u32, native_signed_uniform_choice(<2147483647>, <-2147483648>, <3.5>)) != bitcast(u32, original):
    return 8
  if not native_unsigned_uniform_choice(<4294967295>, <2147483648>) or native_unsigned_uniform_choice(<2147483647>, <2147483648>):
    return 9
  if native_boolean_choice(<true>, <3.5>) != 3.5 or native_boolean_literal() != 2.5:
    return 10
  if bitcast(u32, native_boolean_choice(<false>, <3.5>)) != bitcast(u32, original):
    return 10
  if bitcast(u32, native_boolean_literal_binding()) != bitcast(u32, original):
    return 10
  if native_reduced_choice(<3.5>) != 3.5 or bitcast(u32, native_reduced_choice(<-3.5>)) != bitcast(u32, original):
    return 11
  if native_extract_signed(<-2147483648>) != -2147483648:
    return 12
  if native_insert_unsigned(<0>, <4294967295>) != 4294967295:
    return 13
  if native_relocate_unsigned(<2147483648>) != 2147483648:
    return 14
  return i32(native_identity(<3.5>))
