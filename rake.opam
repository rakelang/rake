# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.7.0"
synopsis: "Rake: A vector-first language for predictable SIMD"
description: """
Rake makes predicated SIMD execution a first-class language construct.
Data rakes through tine declarations (mask patterns), enabling divergent parallel
computations on physical vector targets and the WebAssembly SIMD virtual machine."""
maintainer: ["Kieran Hannigan"]
authors: ["Kieran Hannigan"]
license: "MIT"
homepage: "https://rake-lang.org"
bug-reports: "https://github.com/rakelang/rake/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.1.0"}
  "base-unix"
  "menhir" {>= "20231231"}
  "ppx_deriving" {>= "6.0.0"}
  "js_of_ocaml" {>= "6.0.0"}
  "js_of_ocaml-ppx" {>= "6.0.0"}
  "cmdliner" {>= "1.2.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/rakelang/rake.git"
x-maintenance-intent: ["(latest)"]
