~~ Future examples for stack and field access.

pack Particle {
  f32: x, y, z, mass;
}

pack Energies {
  f32: energy;
}

scratch particle_energy(px: f32s, py: f32s, pz: f32s, mass: f32s) -> f32s:
  let vx2 = px * px
  let vy2 = py * py
  let vz2 = pz * pz
  let speed2 = vx2 + vy2 + vz2
  <0.5> * mass * speed2

run compute_kinetic_energy(particles: stack Particle, energies: stack Energies) -> stack Energies:
  let vx2 = particles.x * particles.x
  let vy2 = particles.y * particles.y
  let vz2 = particles.z * particles.z
  let speed2 = vx2 + vy2 + vz2
  energies with { energy: <0.5> * particles.mass * speed2 }

scratch apply_gravity(y: f32s, <dt: f32>, <gravity: f32>) -> f32s:
  let velocity_delta = <gravity> * <dt>
  y + velocity_delta * <dt>

pack Ray {
  f32: ox, oy, oz, dx, dy, dz;
}

scratch ray_x_at_t(ox: f32s, dx: f32s, <t: f32>) -> f32s:
  ox + dx * <t>

run march_rays(rays: stack Ray, <step: f32>) -> stack Ray:
  rays with { ox: rays.ox + rays.dx * <step> }
