~~ Test: reductions.rk
~~ Tests reduction operators: \+/ \*/ \min/ \max/ \|/ \&/

~~ Sum all elements in a rack
scratch sum_rack values -> result:
  let result = values \+/
  result

~~ Product of all elements
scratch product_rack values -> result:
  let result = values \*/
  result

~~ Minimum value
scratch min_rack values -> result:
  let result = values \min/
  result

~~ Maximum value
scratch max_rack values -> result:
  let result = values \max/
  result

~~ Combine reductions: compute range (max - min)
scratch range_rack values -> result:
  let lo = values \min/
  let hi = values \max/
  let result = hi - lo
  result

~~ Mean calculation: sum / count (using lanes intrinsic)
scratch mean_rack values -> result:
  let total = values \+/
  let count = lanes
  let result = total / count
  result

~~ Logical OR reduction (any true?)
scratch any_positive values -> result:
  let positive = values > <0.0>
  let result = positive \|/
  result

~~ Logical AND reduction (all true?)
scratch all_positive values -> result:
  let positive = values > <0.0>
  let result = positive \&/
  result

~~ Scan operations (prefix sum)
scratch prefix_sum values -> result:
  let result = values \+\
  result

~~ Running product
scratch running_product values -> result:
  let result = values \*\
  result

~~ Running minimum
scratch running_min values -> result:
  let result = values \min\
  result

~~ Running maximum
scratch running_max values -> result:
  let result = values \max\
  result
